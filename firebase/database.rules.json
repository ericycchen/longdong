{
  "rules": {

    "v2": {
      "profiles": {
        ".read": true,
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['name', 'updatedAt'])",
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30" },
          "updatedAt": { ".validate": "newData.isString()" },
          "$other": { ".validate": false }
        }
      },
      "ratings": {
        ".read": true,
        "$route": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $route.length <= 100",
            ".validate": "newData.hasChildren(['stars', 'updatedAt'])",
            "stars": { ".validate": "newData.val() === 1 || newData.val() === 2 || newData.val() === 3 || newData.val() === 4 || newData.val() === 5" },
            "feel": { ".validate": "newData.isString() && newData.val().matches(/^(soft|fair|hard)$/)" },
            "updatedAt": { ".validate": "newData.isString()" },
            "$other": { ".validate": false }
          }
        }
      },
      "comments": {
        ".read": true,
        "$route": {
          "$id": {
            ".write": "auth != null && $route.length <= 100 && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() === auth.uid))",
            ".validate": "newData.hasChildren(['uid', 'text', 'createdAt'])",
            "uid": { ".validate": "newData.isString()" },
            "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1000" },
            "createdAt": { ".validate": "newData.val() === now || (data.exists() && newData.val() === data.val())" },
            "hidden": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        }
      },
      "reports": {
        "$id": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.hasChildren(['path', 'uid', 'createdAt']) && newData.child('uid').val() === auth.uid",
          "path": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "uid": { ".validate": "newData.isString()" },
          "reason": { ".validate": "newData.isString() && newData.val().length <= 500" },
          "createdAt": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      },
      "personal": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          "favorites": {
            "$key": {
              ".validate": "newData.hasChildren(['routeId', 'createdAt', 'updatedAt']) && newData.child('routeId').isString() && newData.child('routeId').val().length <= 100 && newData.child('updatedAt').isString()"
            }
          },
          "ticks": {
            "$id": {
              ".validate": "newData.hasChildren(['id', 'routeId', 'date', 'style', 'createdAt', 'updatedAt']) && newData.child('id').val() === $id && newData.child('routeId').isString() && newData.child('routeId').val().length <= 100 && newData.child('date').val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.child('style').val().matches(/^(onsight|flash|redpoint|follow|toprope|attempt)$/) && (!newData.child('note').exists() || (newData.child('note').isString() && newData.child('note').val().length <= 1000))"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },


    ".read": "root.child('role').child(auth.uid).exists()",
    ".write": "root.child('role').child(auth.uid).exists()",

    "routes": {
      ".read": true,
      "$route_id": {
        "bolts": {
          ".write": "auth.uid !== null"
        }
      }        
    },
    "role": {
      ".read": true
    },

    "comments": {
      ".read": true,
      ".write": "auth.uid !== null"
    },
    "tags": {
      ".read": true,
      ".write": "auth.uid !== null"
    },

    "topos": {
      ".read": true,
      ".write": "auth.uid !== null"
    },

    "tests": {
      ".read": true,
      ".write": "auth.uid !== null"
    },

    "tasks": {
      ".read": true,
      ".write": "auth.uid !== null"
    },

    "devices": {
      "$user_id": {
        ".read": "$user_id === auth.uid",
        ".write": "$user_id === auth.uid"
      }
    },

    "users": {
      "$user_id": {
        ".read": "$user_id === auth.uid",
        ".write": "$user_id === auth.uid"
      }
    }
  }
}
